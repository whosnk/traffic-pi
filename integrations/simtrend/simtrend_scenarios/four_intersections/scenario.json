    },
    "peak": {
      "label": "峰值流量",
      "multiplier": 1.6,
      "description": "模拟早晚高峰或极端拥堵压力测试。"
    }
  },
  "map": {
    "enabled": true,
    "coordinate_system": "sumo_xy",
