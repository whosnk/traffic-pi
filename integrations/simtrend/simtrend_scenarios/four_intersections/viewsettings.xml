<viewsettings>
    <delay value="120"/>
    <viewport zoom="150" x="0" y="0"/>
    <scheme name="simtrend_vehicle_shapes">
        <opengl antialiase="1" dither="0"/>
        <background backgroundColor="245,247,250" showGrid="0" gridXSize="100.00" gridYSize="100.00"/>
        <edges laneEdgeMode="0" scaleMode="0" laneShowBorders="1" showLinkDecals="1" showLinkRules="1"
               hideConnectors="0" widthExaggeration="1.00" minSize="0.00" showDirection="0">
            <colorScheme name="uniform">
                <entry color="45,48,55" name="road"/>
                <entry color="150,150,150" name="sidewalk"/>
                <entry color="red" name="closed"/>
                <entry color="green" name="connector"/>
            </colorScheme>
        </edges>
        <vehicles vehicleMode="8" vehicleQuality="3" vehicle_minSize="1.00" vehicle_exaggeration="1.35"
                  vehicle_constantSize="0" showBlinker="1" drawMinGap="0" drawBrakeGap="0" showRouteIndex="0"
                  vehicleName_show="0" vehicleName_size="50.00" vehicleName_color="204,153,0">
            <colorScheme name="given vehicle/type/route color">
                <entry color="0,0,255"/>
            </colorScheme>
            <colorScheme name="given/assigned vehicle color">
                <entry color="0,0,255"/>
            </colorScheme>
            <colorScheme name="by waiting time" interpolated="1">
                <entry color="0,170,80" threshold="0.00"/>
                <entry color="255,190,40" threshold="30.00"/>
                <entry color="225,45,45" threshold="90.00"/>
            </colorScheme>
        </vehicles>
        <legend showSizeLegend="0"/>
    </scheme>
</viewsettings>
