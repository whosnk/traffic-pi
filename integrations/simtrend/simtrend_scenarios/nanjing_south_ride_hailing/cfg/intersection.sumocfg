<configuration>
    <input>
        <net-file value="../network/intersection.net.xml"/>
        <route-files value="../routes/intersection.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="1800"/>
    </time>
    <report>
        <verbose value="false"/>
        <no-step-log value="true"/>
    </report>
</configuration>
